# Supabase (proyecto propio)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Solo para rutas que usan SQL directo (por ejemplo VSL). En Vercel usa Supavisor en modo
# transaction pooler (puerto 6543) para no agotar conexiones con funciones serverless.
POSTGRES_URL=postgres://postgres.project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres

# Site URL usada en callbacks de auth (login por email / magic link)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Un único cliente OAuth web propiedad de la plataforma. Configura el callback exacto:
# https://app.scalixsystems.com/api/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Bearer JWT del MCP remoto de sequra (https://simba.sequra.com/mcp). CADUCA — cuando el cron
# de /api/evergreen/cron/sequra-morosos empiece a fallar con 401, hay que generar uno nuevo
# desde la sesión MCP de sequra y pegarlo aquí y en Vercel (Production env vars).
SEQURA_MCP_TOKEN=your_sequra_mcp_bearer_token_here

# Sentry (error tracking). Sin DSN, el SDK queda inerte (no manda nada) — crea un proyecto
# Next.js en sentry.io y pega su DSN aquí y en Vercel (Production + Preview env vars).
NEXT_PUBLIC_SENTRY_DSN=
# Opcionales, solo para subir source maps legibles en el build de producción (Vercel):
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── Variables que el servidor LEE y antes no figuraban aquí (todas sin valor: rellénalas en tu .env.local y en Vercel) ──
# OBLIGATORIA: clave de cifrado de las credenciales de integraciones (>= 32 bytes). Sin ella el servidor no arranca el cifrado.
CONFIG_ENC_KEY=
# Bearer compartido por los crons (GitHub Actions / Vercel) y las rutas de reparación.
CRON_SECRET=
# Servidor MCP propio (OAuth 2.1): secreto HS256 de los tokens, >= 32 caracteres. Sin él /api/mcp responde 503.
MCP_JWT_SECRET=
# Tracking del pixel
TRACKING_INGEST_KEY=
TRACKING_IP_SALT=
# Email (Resend)
RESEND_API_KEY=
RESEND_FROM=
RESEND_WEBHOOK_SECRET=
# Secretos de webhooks entrantes (también pueden guardarse por subcuenta en Integraciones)
CALENDLY_WEBHOOK_SECRET=
FATHOM_WEBHOOK_SECRET=
GHL_WEBHOOK_SECRET=
APIFY_WEBHOOK_SECRET=
# Otros
BLOB_READ_WRITE_TOKEN=
GOOGLE_API_KEY=
AI_AGENT_MODEL=
ONBOARDING_LANDING_URL=
