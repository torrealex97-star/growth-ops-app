{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "fluid": true,
  "regions": ["dub1"],
  "functions": {
    "app/api/**/*.ts": { "maxDuration": 60 }
  },
  "git": {
    "deploymentEnabled": {
      "dependabot/**": false,
      "docs/**": false,
      "claude/**": false
    }
  },
  "ignoreCommand": "BASE=${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}; if git diff --quiet $BASE HEAD -- . ':!docs/**' ':!*.md' ':!.agents/**' ':!.claude/skills/**'; then exit 0; else exit 1; fi",
  "crons": [
    { "path": "/api/_/evergreen/cron/meta-ads", "schedule": "0 2 * * *" },
    { "path": "/api/_/evergreen/cron/reminders", "schedule": "0 7 * * *" }
  ]
}
