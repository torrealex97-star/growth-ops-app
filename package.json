{
  "name": "growth-ops-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,json,css}\"",
    "dead-code": "knip --no-exit-code",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "tipos:bd": "node scripts/generar-tipos-bd.mjs",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/register.mjs --test tests/*.test.mjs",
    "test:metrics": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/register.mjs --test tests/metrics/*.test.mjs",
    "test:attribution": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/register.mjs --test tests/attribution-trajectory.test.mjs tests/appointment-attribution-evidence.test.mjs tests/citas-sync-atribucion.test.mjs tests/tracking-fase-c.test.mjs tests/webhook-ghl.test.mjs",
    "quality": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:metrics",
    "mcp:supabase": "npx -y @supabase/mcp-server-supabase@latest --read-only --project-ref rgcbveflosqgxrcqlqzv",
    "mcp:search": "npx -y duckduckgo-mcp-server",
    "mcp:context7": "npx -y @upstash/context7-mcp",
    "mcp:repomix": "npx -y repomix --mcp",
    "context:build": "npx -y repomix --config repomix.config.json",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:rls:live": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/qa/rls-multitenant.mjs",
    "emails:build": "tsx scripts/build-emails.tsx",
    "emails:check": "tsx scripts/build-emails.tsx --check"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
