    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@sentry/nextjs": "^11.8.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-table": "^8.21.3",
    "@vercel/blob": "^2.8.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "googleapis": "^188.0.0",
    "hls.js": "^1.6.16",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.1",
    "lucide-react": "^1.61.0",
    "next": "^15.5.28",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.90.0",
    "recharts": "^3.10.1",
    "resend": "^6.34.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "tus-js-client": "^4.3.1",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.28"
    },
    "@vercel/blob": {
      "undici": "^6.29.1"
    },
    "@vercel/oidc": {
      "zod": "^4.6.7"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.1.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "dotenv": "^18.0.8",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "knip": "^6.42.1",
    "postcss": "^8",
    "prettier": "^3.9.10",
